// 187 (LIVE) -- SqlConfigStore end-to-end against a RUNNING BTreeDB server (P1 gate: the config store
// works over the real driver on one node). NOT part of the offline suite (it lives under tests/live/ so
// run-tests.sh's tests/*.nova glob skips it). Run it with a fresh btree server on 127.0.0.1:3009:
//
//   (cd btree && rm -rf nova.db wal && ./zig-out/bin/btree &)   # fresh server
//   (cd lang && nova test ../packages/nova-orchestrator/tests/live/187_sqlconfig_live.nova)
//
// It drives the whole etcd-shaped API (ensureSchema/put/get/list/cas/del) over the nova-novadb driver on
// the reactor, then reconciles a nativelet from list("workloads/") -- proving the store-driven reconcile
// against real persistence. The reactor is pumped manually (conformance 205 pattern) because the driver's
// async socket I/O needs a running loop.
import assert;
import bytes;
import string;
import db;
import novadb;
import net.poller;
import store.sqlconfig;
import store.config;
import orch.nativelet;

fn specJson(name: string, reps: int): string {
    return "{\"name\":\"" + name + "\",\"binaryPath\":\"/bin/" + name + "\",\"replicas\":" + reps + "}";
}

// The integration coroutine: assertions abort the process on failure (=> test fails); on success it sets
// done := 1 so the pump loop exits.
async fn runLive(donePtr: long): void {
    let driver = novadb.NovaDriver();
    let conn = await driver.connect("127.0.0.1:3009");
    let s = sqlconfig.SqlConfigStore(conn);
    await s.ensureSchema();

    // put -> monotonic revision; get decodes value + mod-revision.
    let r1 = await s.put("workloads/web", specJson("web", 2));
    assert.isTrue(r1 == 1);
    let r2 = await s.put("workloads/api", specJson("api", 1));
    assert.isTrue(r2 == 2);
    let rev = await s.revision();
    assert.isTrue(rev == 2);

    let web = await s.get("workloads/web") ?? config.ConfigEntry("", "", 0);
    assert.isTrue(web.revision == 1);
    assert.contains(web.value, "\"replicas\":2");

    // overwrite advances value + revision
    let r3 = await s.put("workloads/web", specJson("web", 3));
    assert.isTrue(r3 == 3);
    let web2 = await s.get("workloads/web") ?? config.ConfigEntry("", "", 0);
    assert.contains(web2.value, "\"replicas\":3");
    assert.isTrue(web2.revision == 3);

    let hasNone = await s.exists("workloads/none");
    assert.isFalse(hasNone);

    // list under prefix
    let wl = await s.list("workloads/");
    assert.equalInt(wl.size(), 2);

    // CAS: create-only lease, then a stale + a good renew (revisions continue from 3).
    let c1 = await s.cas("leases/leader", "node-1", 0);
    assert.isTrue(c1 == 4);
    let c2 = await s.cas("leases/leader", "node-2", 0);       // already exists
    assert.isTrue(c2 == -1);
    let stale = await s.cas("leases/leader", "node-3", 99);   // wrong revision
    assert.isTrue(stale == -1);
    let renew = await s.cas("leases/leader", "node-1b", 4);   // current revision 4
    assert.isTrue(renew == 5);
    let lease = await s.get("leases/leader") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(lease.value, "node-1b");

    // delete drops the key + advances the revision
    let deleted = await s.del("workloads/api");
    assert.isTrue(deleted);
    let wl2 = await s.list("workloads/");
    assert.equalInt(wl2.size(), 1);

    // STORE-DRIVEN RECONCILE against real persistence: the nativelet converges from list("workloads/").
    let n = nativelet.Nativelet("unused-dir");
    n.manageProcesses = false;
    let entries = await s.list("workloads/");
    n.reconcileFromEntries(entries, "workloads/");
    assert.equalInt(n.jobs.size(), 1);                        // only web remains
    assert.isTrue(n.findJobIdx("web") >= 0);
    assert.equalInt(n.desiredReplicas("web"), 3);            // the overwritten spec

    // Audit trail round-trips through real btree (placed LAST so its extra revisions don't shift the CAS
    // revision expectations above). putBy stamps updated_by + updated_at, get() reads both back: updated_by
    // (TEXT) is the actor, updated_at is the unix-seconds stamp (> 0 proves it was written from the clock).
    let _ab = await s.putBy("workloads/audited", specJson("audited", 1), "operator-alice");
    let aud = await s.get("workloads/audited") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(aud.updatedBy, "operator-alice");
    assert.isTrue(aud.updatedAt > 0);

    conn.close();
    bytes.write_i32(donePtr, 0, 1);
}

@test
fn test_sqlconfig_live_e2e(): void {
    let r = poller.Reactor(64, 8192, 32);
    poller.setCurrent(r.kq);
    let done = bytes.alloc(4);
    bytes.write_i32(done, 0, 0);

    coroStart(runLive(done));

    let guard = 0;
    while (bytes.read_i32(done, 0) < 1 && guard < 20000) {
        let nev = r.pollComplete(500);
        poller.batchBegin();
        let i = 0;
        while (i < nev) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
        guard = guard + 1;
    }

    assert.equalInt(bytes.read_i32(done, 0) as int, 1);      // coroutine finished all asserts + set done
    poller.setCurrent(0);
    bytes.free(done);
    r.destroy();
}
