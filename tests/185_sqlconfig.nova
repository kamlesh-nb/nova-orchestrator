// 185 -- the SQL-backed config store (store/sqlconfig.nova) exercised OFFLINE against a FakeConn that
// simulates the config + config_meta tables. A sync @test block-drives SqlConfigStore's async methods
// (the seam is async; a sync test drives it -- see conformance 104_conn_pool). This proves the op->SQL
// mapping, parameter order, revision counter, CAS-on-revision, and result decoding end-to-end without a
// live server; the same logic against real BTreeDB is the live integration step.
import assert;
import list;
import string;
import db;
import store.sqlconfig;
import store.config;

// A Connection that simulates exactly the statements SqlConfigStore emits, over in-memory parallel arrays
// (config table) + a counter (config_meta). Structs are ARC ref types, so mutations through `self` are
// visible to the test's handle. Keys in parallel Lists, not Map<string,_> (which mono-miscompiles today).
struct FakeConn impl Connection {
    pub keys: List<string>,
    pub vals: List<string>,
    pub revs: List<int>,
    pub bys: List<string>,      // updated_by column
    pub ats: List<int>,         // updated_at column (unix seconds; INT)
    pub metaRev: int,
    pub raceMode: bool,         // when true, the exists()-style revision SELECT reports ABSENT even if the
                                // key is present -- simulates the TOCTOU window where a racer inserted after
                                // this node's exists() ran, so only the PK conflict on INSERT can arbitrate.

    init() {
        self.keys = List<string>();
        self.vals = List<string>();
        self.revs = List<int>();
        self.bys = List<string>();
        self.ats = List<int>();
        self.metaRev = 0;
        self.raceMode = false;
    }

    fn find(self: FakeConn, key: string): int {
        let i = 0;
        while (i < self.keys.size()) {
            if (string.eql(self.keys.at(i), key)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    pub async fn exec(self: FakeConn, sql: string, params: List<DbValue>): ExecResult {
        if (string.contains(sql, "CREATE TABLE")) { return ExecResult(0, "OK"); }
        if (string.contains(sql, "config_meta")) {
            if (string.contains(sql, "UPDATE")) { self.metaRev = params.at(0).asInt(); } // SET rev = $1
            return ExecResult(1, "OK");           // UPDATE set-value or INSERT seed
        }
        if (string.contains(sql, "DELETE FROM config")) {
            let at = self.find(params.at(0).asText());
            if (at < 0) { return ExecResult(0, "OK"); }
            self.keys.remove(at);
            self.vals.remove(at);
            self.revs.remove(at);
            self.bys.remove(at);
            self.ats.remove(at);
            return ExecResult(1, "OK");
        }
        if (string.contains(sql, "INSERT INTO config")) {
            // INSERT (k, v, revision, updated_by, updated_at) VALUES ($1..$5). `config.k` is the PRIMARY KEY,
            // so a second creator of the same key is rejected with a duplicate-key conflict (0 rows) -- this
            // is what makes the create-only CAS a true single-winner primitive.
            let k = params.at(0).asText();
            if (self.find(k) >= 0) { return ExecResult(0, "duplicate key (k is PRIMARY KEY)"); }
            self.keys.push(k);
            self.vals.push(params.at(1).asText());
            self.revs.push(params.at(2).asInt());
            self.bys.push(params.at(3).asText());
            self.ats.push(params.at(4).asInt());
            return ExecResult(1, "OK");
        }
        if (string.contains(sql, "UPDATE config SET")) {
            // SET v = $1, revision = $2, updated_by = $3, updated_at = $4 WHERE k = $5 [AND revision = $6]
            let v = params.at(0).asText();
            let rev = params.at(1).asInt();
            let by = params.at(2).asText();
            let ts = params.at(3).asInt();
            let at = self.find(params.at(4).asText());
            if (at < 0) { return ExecResult(0, "OK"); }
            // CAS revision guard: the guarded UPDATE only matches when the row's current revision equals the
            // expected one ($6). Real NovaDB evaluates this in the WHERE; the fake must too, or a stale CAS
            // silently "succeeds" (the split-brain vector). A plain put() has no guard and always matches.
            if (string.contains(sql, "AND revision = $6")) {
                if (self.revs.at(at) != params.at(5).asInt()) { return ExecResult(0, "OK"); }   // revision moved: CAS lost
            }
            self.vals.set(at, v);
            self.revs.set(at, rev);
            self.bys.set(at, by);
            self.ats.set(at, ts);
            return ExecResult(1, "OK");
        }
        return ExecResult(0, "OK");
    }

    pub async fn query(self: FakeConn, sql: string, params: List<DbValue>): ResultSet {
        let rs = ResultSet();
        if (string.contains(sql, "config_meta")) {
            rs.columns.push(Column("rev", DbType.Int4));
            let r = Row();
            r.cells.push(dbInt(self.metaRev));
            rs.rows.push(r);
            return rs;
        }
        if (string.contains(sql, "WHERE k = $1")) {
            // raceMode: blind the exists()-style revision probe (NOT the full get) so casBy's create path
            // reaches the INSERT and must be arbitrated by the PRIMARY KEY conflict.
            if (self.raceMode && !string.contains(sql, "SELECT v, revision")) { return rs; }
            let at = self.find(params.at(0).asText());
            if (at < 0) { return rs; }            // 0 rows
            let r = Row();
            if (string.contains(sql, "SELECT v, revision")) {
                // SELECT v, revision, updated_by, updated_at
                r.cells.push(dbText(self.vals.at(at)));
                r.cells.push(dbInt(self.revs.at(at)));
                r.cells.push(dbText(self.bys.at(at)));
                r.cells.push(dbInt(self.ats.at(at)));
            } else {
                r.cells.push(dbInt(self.revs.at(at)));   // SELECT revision ... (exists)
            }
            rs.rows.push(r);
            return rs;
        }
        // SELECT k, v, revision, updated_by, updated_at FROM config  (full scan)
        let i = 0;
        while (i < self.keys.size()) {
            let r = Row();
            r.cells.push(dbText(self.keys.at(i)));
            r.cells.push(dbText(self.vals.at(i)));
            r.cells.push(dbInt(self.revs.at(i)));
            r.cells.push(dbText(self.bys.at(i)));
            r.cells.push(dbInt(self.ats.at(i)));
            rs.rows.push(r);
            i = i + 1;
        }
        return rs;
    }

    pub fn close(self: FakeConn): void { }
    pub fn setTimeout(self: FakeConn, ms: int): int { return 0; }
    pub async fn prepare(self: FakeConn, sql: string): int { return 0; }
    pub async fn queryWire(self: FakeConn, sql: string, params: List<DbValue>): db.WireRows {
        return db.wireRowsFromResultSet(await self.query(sql, params));
    }
    pub async fn queryPrepared(self: FakeConn, stmt: int, params: List<DbValue>): ResultSet { return ResultSet(); }
    pub async fn execPrepared(self: FakeConn, stmt: int, params: List<DbValue>): ExecResult { return ExecResult(0, ""); }
    pub async fn begin(self: FakeConn): ExecResult { return ExecResult(0, ""); }
    pub async fn commit(self: FakeConn): ExecResult { return ExecResult(0, ""); }
    pub async fn rollback(self: FakeConn): ExecResult { return ExecResult(0, ""); }
}

@test
fn test_sql_put_get_revision(): void {
    let s = sqlconfig.SqlConfigStore(FakeConn());
    s.ensureSchema();
    assert.isTrue(s.revision() == 0);

    let r1 = s.put("workloads/web", "spec-a");
    assert.isTrue(r1 == 1);
    assert.isTrue(s.revision() == 1);

    let r2 = s.put("workloads/api", "spec-b");
    assert.isTrue(r2 == 2);

    let web = s.get("workloads/web") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(web.value, "spec-a");
    assert.isTrue(web.revision == 1);

    // overwrite: value + mod-revision advance
    let r3 = s.put("workloads/web", "spec-a2");
    assert.isTrue(r3 == 3);
    let web2 = s.get("workloads/web") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(web2.value, "spec-a2");
    assert.isTrue(web2.revision == 3);

    assert.isFalse(s.exists("workloads/none"));
    let miss = s.get("workloads/none") ?? config.ConfigEntry("MISS", "", 0);
    assert.equalStr(miss.key, "MISS");
}

@test
fn test_sql_list_prefix(): void {
    let s = sqlconfig.SqlConfigStore(FakeConn());
    s.ensureSchema();
    let _1 = s.put("workloads/web", "a");
    let _2 = s.put("leases/leader", "node-1");
    let _3 = s.put("workloads/api", "b");

    let wl = s.list("workloads/");
    assert.equalInt(wl.size(), 2);
    assert.equalStr((wl.at(0)).key, "workloads/web");
    assert.equalStr((wl.at(1)).key, "workloads/api");

    let leases = s.list("leases/");
    assert.equalInt(leases.size(), 1);
    assert.equalStr((leases.at(0)).value, "node-1");

    assert.equalInt(s.list("nothing/").size(), 0);
}

@test
fn test_sql_cas(): void {
    let s = sqlconfig.SqlConfigStore(FakeConn());
    s.ensureSchema();

    // create-only (expected 0): succeeds when absent, fails when present.
    let c1 = s.cas("leases/leader", "node-1", 0);
    assert.isTrue(c1 == 1);
    let c2 = s.cas("leases/leader", "node-2", 0);
    assert.isTrue(c2 == -1);
    let cur = s.get("leases/leader") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(cur.value, "node-1");

    // stale revision fails; current revision succeeds and advances.
    let stale = s.cas("leases/leader", "node-3", 99);
    assert.isTrue(stale == -1);
    let ok = s.cas("leases/leader", "node-1-renewed", 1);
    assert.isTrue(ok == 2);
    let renewed = s.get("leases/leader") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(renewed.value, "node-1-renewed");
    assert.isTrue(renewed.revision == 2);
}

@test
fn test_sql_delete(): void {
    let s = sqlconfig.SqlConfigStore(FakeConn());
    s.ensureSchema();
    let _1 = s.put("workloads/web", "a");
    let _2 = s.put("workloads/api", "b");
    assert.isTrue(s.revision() == 2);

    assert.isTrue(s.del("workloads/web"));
    assert.isFalse(s.exists("workloads/web"));
    assert.isTrue(s.revision() == 3);            // delete advanced the global revision
    assert.equalInt(s.list("workloads/").size(), 1);

    assert.isFalse(s.del("workloads/web"));       // absent -> no-op, no revision bump
    assert.isTrue(s.revision() == 3);
}

// Audit trail: putBy/casBy stamp updated_by (and updated_at) and get/list read them back.
@test
fn test_sql_audit_trail(): void {
    let s = sqlconfig.SqlConfigStore(FakeConn());
    s.ensureSchema();

    let _1 = s.putBy("workloads/web", "spec-a", "operator-alice");
    let web = s.get("workloads/web") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(web.updatedBy, "operator-alice");
    assert.isTrue(web.updatedAt > 0);                 // stamped from the clock

    // A plain put() attributes to the default actor.
    let _2 = s.put("workloads/api", "spec-b");
    let api = s.get("workloads/api") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(api.updatedBy, "system");

    // An overwrite via putBy re-attributes the row to the new actor.
    let _3 = s.putBy("workloads/web", "spec-a2", "operator-bob");
    let web2 = s.get("workloads/web") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(web2.updatedBy, "operator-bob");

    // casBy carries the actor on the create path, and list() surfaces it.
    let c = s.casBy("leases/leader", "node-1", 0, "election");
    assert.isTrue(c > 0);
    let leases = s.list("leases/");
    assert.equalInt(leases.size(), 1);
    assert.equalStr((leases.at(0)).updatedBy, "election");
}

@test
fn test_sql_watch_since(): void {
    let s = sqlconfig.SqlConfigStore(FakeConn());
    s.ensureSchema();
    let _1 = s.put("workloads/web", "a");         // rev 1
    let _2 = s.put("workloads/api", "b");         // rev 2
    let mark = s.revision();                       // 2
    let _3 = s.put("workloads/worker", "c");      // rev 3
    let _4 = s.put("workloads/web", "a2");        // rev 4

    assert.equalInt(s.watch("workloads/", 0).size(), 3);

    let recent = s.watch("workloads/", mark);
    assert.equalInt(recent.size(), 2);
    // web (updated in place, rev 4) then worker (rev 3)
    assert.equalStr((recent.at(0)).key, "workloads/web");
    assert.isTrue((recent.at(0)).revision == 4);
    assert.equalStr((recent.at(1)).key, "workloads/worker");
    assert.isTrue((recent.at(1)).revision == 3);

    assert.equalInt(s.watch("leases/", 0).size(), 0);
}

// Leader-lease create-race: create-only CAS (expectedRevision 0) must yield EXACTLY ONE winner when two
// nodes race a FREE lease. The common sequential case is caught by exists(); the CONCURRENT case is caught
// by the PRIMARY KEY conflict on INSERT (the authoritative arbiter the old code ignored).
@test
fn test_create_only_cas_single_winner_sequential(): void {
    let s = sqlconfig.SqlConfigStore(FakeConn());
    s.ensureSchema();
    let r1 = s.casBy("leases/leader", "node-A", 0, "A");   // first creator wins epoch 1
    assert.isTrue(r1 > 0);
    let r2 = s.casBy("leases/leader", "node-B", 0, "B");   // key present -> CAS lost
    assert.isTrue(r2 == -1);
    let e = s.get("leases/leader") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(e.value, "node-A");
}

@test
fn test_create_race_insert_is_authoritative(): void {
    // A racer already created the lease. Blind this node's exists() (raceMode) to simulate the TOCTOU window,
    // so the create path reaches the INSERT. The OLD code discarded the INSERT result and would have "won"
    // epoch 1 too (split-brain); the fix checks rows_affected, so the duplicate-key conflict makes it LOSE.
    let conn = FakeConn();
    let winner = sqlconfig.SqlConfigStore(conn);
    winner.ensureSchema();
    let rw = winner.casBy("leases/leader", "node-A", 0, "A");
    assert.isTrue(rw > 0);                 // the racer that got there first holds the lease

    conn.raceMode = true;                  // now exists() is blind to the existing key for this node
    let loser = sqlconfig.SqlConfigStore(conn);
    let rl = loser.casBy("leases/leader", "node-B", 0, "B");
    assert.isTrue(rl == -1);               // INSERT rejected by the PK -> CAS lost (single winner)

    conn.raceMode = false;
    let e = loser.get("leases/leader") ?? config.ConfigEntry("", "", 0);
    assert.equalStr(e.value, "node-A");    // the loser did not overwrite the winner
}
