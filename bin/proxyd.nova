// proxyd -- the DATA-plane binary of the split orchestrator stack.
//
// A standalone L7 reverse proxy / load balancer: it owns TRAFFIC, nothing else. It builds a backend
// Pool from a validated JSON config (static backends and/or a control-plane service-discovery file that
// orchd publishes), applies the configured LB strategy + active health checks, and serves forever with
// the share-nothing per-reactor accept fan-out. It has no knowledge of workload lifecycle, manifests, or
// the config store -- that is orchd's job. The two coordinate ONLY through the discovery file.
//
//   proxyd [config.json]        # default: proxyd.json ; or set PROXYD_CONFIG ; NOVA_PORT overrides the port
import net.proxy;
import net.service;
import net.aio;
import cfg.config;
import env;
import string;

fn strategyOf(s: string): proxy.LbStrategy {
    if (string.eql(s, "weighted")) { return proxy.LbStrategy.Weighted; }
    if (string.eql(s, "leastconn")) { return proxy.LbStrategy.LeastConn; }
    if (string.eql(s, "consistenthash")) { return proxy.LbStrategy.ConsistentHash; }
    return proxy.LbStrategy.RoundRobin;
}

// Add the endpoint advertised in the discovery file (written by orchd's ServiceRegistry), if present.
fn addDiscovered(pool: proxy.Pool, discoveryFile: string, svc: string): void {
    if (string.eql(discoveryFile, "")) { return; }
    let ep = service.resolveFrom(discoveryFile, svc);
    if (string.eql(ep, "")) { return; }
    let hp = string.split(ep, ":");
    if (hp.size() < 2) { return; }
    let host = hp.get(0) ?? "";
    let port = string.parseI64(hp.get(1) ?? "0") as int;
    if (!string.eql(host, "") && port > 0) { pool.add(host, port); }
}

fn main(): int {
    let path = config.resolveConfigPath("PROXYD_CONFIG", "proxyd.json");
    let c = config.loadProxyConfig(path);

    // Port override for parity with the flagship NOVA_PORT convention (many proxyd replicas on one host).
    let pe = env.get("NOVA_PORT");
    if (!string.eql(pe, "")) { c.listenPort = string.parseI64(pe) as int; }

    let err = config.validateProxy(c);
    if (!string.eql(err, "")) {
        console.log(`proxyd: invalid config (${path}): ${err}`);
        return 1;
    }

    let pool = proxy.Pool();
    pool.setStrategy(strategyOf(c.strategy));
    if (c.healthChecks) {
        pool.setHealthPath(c.healthPath);
        pool.enableHealthChecks(c.healthIntervalMs, c.healthTimeoutMs, c.healthRise, c.healthFall);
    }
    let i = 0;
    while (i < c.backends.size()) {
        let b = c.backends.get(i) ?? config.BackendCfg("", 0, 1);
        pool.addWeighted(b.host, b.port, b.weight);
        i = i + 1;
    }
    addDiscovered(pool, c.discoveryFile, c.discoveryService);

    if (pool.size() == 0) {
        console.log("proxyd: no live backends (static + discovery both empty); refusing to start");
        return 1;
    }

    if (config.hasFlag("--check")) {
        console.log(`proxyd: config OK (${path}), ${pool.size()} backend(s), strategy=${c.strategy}`);
        return 0;
    }

    let bindHost = if (string.eql(c.listenHost, "")) "*" else c.listenHost;
    console.log(`proxyd: listening on ${bindHost}:${c.listenPort}, ${pool.size()} backend(s), strategy=${c.strategy}, health=${c.healthChecks}`);
    // holdReactors keeps every reactor alive BEFORE the block-drive so the per-reactor accept fan-out
    // lands on live reactors (share-nothing). serveAddr blocks forever, driving the reactor.
    aio.holdReactors();
    let _ = proxy.serveAddr(pool, c.listenHost, c.listenPort, c.timeoutMs);
    return 0;
}
