// orch/artifact.ky -- resolve a workload's content-addressed `artifact` to a local, verified binary.
//
// A Spec's `artifact` is "sha256:<hex>". kynatord keeps a per-node BlobStore cache; before it can spawn a
// replica it must have that exact blob locally. This module is the seam between the manifest's hash and
// the supervisor's binaryPath:
//   - resolveBinary: hash -> a local path if cached, else NotCached (the caller pulls, then retries).
//   - cacheArtifact: verify pulled bytes hash to their name and publish them (Corrupt on mismatch).
// The actual fetch over HTTP (web.client GET /artifacts/<sha> from the artifact origin) + the exec-bit
// are the caller's integration step; keeping them out here makes the verify/cache logic unit-testable
// without a network or a live server.
import string;
import artifacts.blobstore;

pub exception ArtifactError {
    NotCached(string),      // the blob is not on this node yet -- pull it, then resolve again
    Corrupt(string),        // fetched bytes did not hash to their claimed sha -- reject, never run

    pub fn message(self: ArtifactError): string {
        switch (self) {
            case ArtifactError.NotCached(s): { return "artifact not cached: " + s; }
            case ArtifactError.Corrupt(s): { return "artifact failed hash verification: " + s; }
        }
        return "artifact error";
    }
}

// "sha256:<hex>" -> "<hex>"; a bare "<hex>" is returned unchanged. Any other scheme yields "".
pub fn shaOf(artifact: string): string {
    if (string.startsWith(artifact, "sha256:")) { return string.slice(artifact, 7, artifact.length); }
    return artifact;
}

// Resolve a spec to a local executable path. Legacy specs (no artifact) use binaryPath verbatim.
// A content-addressed spec resolves to the cached blob's path, or NotCached when it must be pulled first.
pub fn resolveBinary(artifact: string, binaryPath: string, cache: blobstore.BlobStore): string | ArtifactError {
    if (string.eql(artifact, "")) { return binaryPath; }         // legacy local-path mode
    let sha = shaOf(artifact);
    if (cache.has(sha)) { return cache.localPath(sha); }
    return ArtifactError.NotCached(sha);
}

// Verify + publish freshly-fetched bytes into the cache, returning the local path. The BlobStore rejects
// bytes that do not hash to `sha`, so a corrupt or tampered download can never become a runnable file.
pub fn cacheArtifact(cache: blobstore.BlobStore, sha: string, data: string): string | ArtifactError {
    if (!cache.put(sha, data)) { return ArtifactError.Corrupt(sha); }
    return cache.localPath(sha);
}
