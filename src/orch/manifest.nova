// orch/manifest.nova — the DECLARATIVE app manifest (YAML), the single source of truth for a workload.
//
// One YAML document describes everything the control plane needs to run and front an app: the binary
// and how many replicas to keep (a min/max band), the autoscaler policy, the load-balancer strategy,
// health probing, network exposure, HTTP routes, and resource limits. It replaces the scattered
// config (service.json + env vars + code-configured autoscaler): orchd loads these manifests, the
// gateway reads the LB/exposure, and the autoscaler reads its gains — all from here.
//
// Parsed with the compiler-generated binder over YAML: `Manifest__bind(source.fromYaml(text))`. Every
// nested struct is @serializable with a zero-arg init() that sets defaults, so a partial manifest
// fills in sensible values. Shape (see examples/manifests/shop.yaml):
//
//   apiVersion: nova/v1
//   kind: App
//   metadata: { name: shop }
//   workload: { binary: ./bin/webapp, args: [], restartPolicy: always }
//   replicas: { min: 2, max: 6 }
//   autoscale: { enabled: true, metric: inflight, setpoint: 8, kp: 0.8, ki: 0.1, kd: 0.0, intervalMs: 2000 }
//   lb: { strategy: roundrobin, handoff: true }
//   health: { path: /healthz, intervalMs: 2000, timeoutMs: 1000, rise: 2, fall: 3 }
//   network: { expose: gateway-only }
//   routes: [ /api/products, /api/orders ]
//   resources: { cpuMilli: 500, memMaxBytes: 268435456, pidsMax: 128 }
import serde.source;
import io.file;
import string;
import list;
import orch.spec;
import net.proxy;
import net.autoscale;
import net.netns;
import platform;

@serializable
struct Metadata {
    pub name: string,        // unique workload key
    init() { self.name = ""; }
}

@serializable
struct Workload {
    pub binary: string,          // native executable to run per replica
    pub args: List<string>,      // argv (excluding the binary and the injected port)
    pub restartPolicy: string,   // always | on-failure | never
    init() {
        self.binary = "";
        self.args = List<string>();
        self.restartPolicy = "always";
    }
}

// The replica band the autoscaler operates within. A fixed count is min == max.
@serializable
struct Replicas {
    pub min: int,
    pub max: int,
    init() { self.min = 1; self.max = 1; }
}

// PID autoscaler policy. metric selects the regulated signal: "inflight" (in-flight requests, the
// gateway's own load metric) or "cpu" (the workload cgroup's CPU utilisation, Linux). The controller is
// direct-acting, output clamped to [replicas.min, replicas.max]. See net/autoscale.PidController.
@serializable
struct Autoscale {
    pub enabled: bool,
    pub metric: string,          // inflight | cpu
    pub setpoint: double,        // target value of the metric
    pub kp: double,
    pub ki: double,
    pub kd: double,
    pub intervalMs: int,         // control loop period
    init() {
        self.enabled = false;
        self.metric = "inflight";
        self.setpoint = 0.0;
        self.kp = 0.5;
        self.ki = 0.1;
        self.kd = 0.0;
        self.intervalMs = 2000;
    }
}

// Load-balancer facing this app. `handoff` selects the fire-and-forget fd-passing data path (the app
// receives client sockets over the gateway's AF_UNIX rendezvous and is NOT exposed on a TCP port);
// otherwise the gateway byte-forwards to the replicas.
@serializable
struct Lb {
    pub strategy: string,        // roundrobin | weighted | leastconn | consistenthash
    pub handoff: bool,           // fd-passing data path — the DEFAULT (out-of-path); set false for classic L7
    init() { self.strategy = "roundrobin"; self.handoff = true; }
}

@serializable
struct Health {
    pub path: string,            // "" = TCP-connect probe; non-empty = HTTP GET, expect 2xx/3xx
    pub intervalMs: int,
    pub timeoutMs: int,
    pub rise: int,               // consecutive OK probes to return a backend to rotation
    pub fall: int,               // consecutive failed probes to drain a backend
    init() {
        self.path = "/healthz";
        self.intervalMs = 2000;
        self.timeoutMs = 1000;
        self.rise = 2;
        self.fall = 3;
    }
}

// Network exposure INTENT. The isolation implementation is platform-selected (like the reactor backend):
// "gateway-only" => the app is reachable ONLY through the gateway — via fd-handoff on macOS/Windows (the
// app has no listening TCP port) or a veth + network namespace on Linux; "public" => the app binds a
// host port directly (dev convenience, not for production).
@serializable
struct Network {
    pub expose: string,          // gateway-only | public
    // Exposure port config, used ONLY when expose == "public": replica i binds portBase + i and the
    // supervisor passes that port via portFlag on spawn (e.g. "--port"). Ignored for gateway-only
    // (handoff apps have no listening port). portBase 0 = not directly exposed.
    pub portBase: int,
    pub portFlag: string,
    // The public front port the workload's SERVICE (gateway) listens on. Clients hit this; the service
    // hands connections to the app replicas (handoff) or forwards to them. Default 8080.
    pub servicePort: int,
    init() { self.expose = "gateway-only"; self.portBase = 0; self.portFlag = ""; self.servicePort = 8080; }
}

// cgroups-v2 resource limits (Linux; 0 = unset). cpuMilli is milli-CPU (500 = 0.5 core).
@serializable
struct Resources {
    pub cpuMilli: int,
    pub memMaxBytes: long,
    pub pidsMax: int,
    init() { self.cpuMilli = 0; self.memMaxBytes = 0; self.pidsMax = 0; }
}

@serializable
struct Manifest {
    pub apiVersion: string,
    pub kind: string,
    pub metadata: Metadata,
    pub workload: Workload,
    pub replicas: Replicas,
    pub autoscale: Autoscale,
    pub lb: Lb,
    pub health: Health,
    pub network: Network,
    pub resources: Resources,
    pub routes: List<string>,
    init() {
        self.apiVersion = "nova/v1";
        self.kind = "App";
        self.metadata = Metadata();
        self.workload = Workload();
        self.replicas = Replicas();
        self.autoscale = Autoscale();
        self.lb = Lb();
        self.health = Health();
        self.network = Network();
        self.resources = Resources();
        self.routes = List<string>();
    }
}

// Parse a YAML manifest string into a Manifest (defaults fill any absent field).
pub fn parseManifest(text: string): Manifest {
    return Manifest__bind(source.fromYaml(text));
}

// Load and parse a manifest file. Returns a Manifest with all-default fields if the file is missing
// (validate() then reports the empty name/binary).
pub fn loadManifest(path: string): Manifest {
    if (!file.File.exists(path)) { return Manifest(); }
    return parseManifest(file.File.readText(path));
}

fn oneOf(v: string, a: string, b: string, c: string, d: string): bool {
    return string.eql(v, a) || string.eql(v, b) || string.eql(v, c) || string.eql(v, d);
}

// Validate a manifest; returns "" when valid, else the first problem. Keeps the control plane from
// acting on a nonsensical spec (empty name/binary, an inverted replica band, an unknown enum).
pub fn validateManifest(m: Manifest): string {
    if (string.eql(m.metadata.name, "")) { return "metadata.name is required"; }
    if (string.eql(m.workload.binary, "")) { return "workload.binary is required"; }
    if (m.replicas.min < 1) { return "replicas.min must be >= 1"; }
    if (m.replicas.max < m.replicas.min) { return "replicas.max must be >= replicas.min"; }
    if (!oneOf(m.lb.strategy, "roundrobin", "weighted", "leastconn", "consistenthash")) {
        return "lb.strategy must be roundrobin | weighted | leastconn | consistenthash";
    }
    if (!string.eql(m.network.expose, "gateway-only") && !string.eql(m.network.expose, "public")) {
        return "network.expose must be gateway-only | public";
    }
    if (m.autoscale.enabled) {
        if (!string.eql(m.autoscale.metric, "inflight") && !string.eql(m.autoscale.metric, "cpu")) {
            return "autoscale.metric must be inflight | cpu";
        }
        if (m.autoscale.setpoint <= 0.0) { return "autoscale.setpoint must be > 0 when autoscaling"; }
    }
    return "";
}

// Lower a Manifest to the supervisor's Spec — the seam between the declarative surface and the process
// runner. The supervisor keeps `replicas` copies running; the INITIAL desired count is replicas.min, and
// the control-plane autoscaler later drives spec.replicas within [replicas.min, replicas.max]. Exposure:
// a "public" app binds network.portBase (+ i per replica) via portFlag and probes that port; a
// "gateway-only" app is not directly exposed (basePort 0) — it is reached via the gateway (fd-handoff on
// macOS/Windows, veth on Linux), so no host port is advertised.
pub fn toSpec(m: Manifest): spec.Spec {
    let s = spec.Spec(m.metadata.name, m.workload.binary);
    let i = 0;
    while (i < m.workload.args.size()) { s.args.push(m.workload.args.get(i) ?? ""); i = i + 1; }
    s.restartPolicy = m.workload.restartPolicy;
    s.replicas = if (m.replicas.min < 1) 1 else m.replicas.min;
    s.cpuMilli = m.resources.cpuMilli;
    s.memMaxBytes = m.resources.memMaxBytes;
    s.pidsMax = m.resources.pidsMax;
    s.probePath = m.health.path;
    s.probePeriodMs = if (m.health.intervalMs > 0) m.health.intervalMs else 2000;
    // Precedence: an explicitly PUBLIC app keeps its host port; otherwise (gateway-only) fd-passing
    // handoff is the default data path (no listening port — the app receives client sockets over the
    // service's AF_UNIX rendezvous, whose path is derived from the workload name so service + apps
    // agree); netns is the gateway-only path only when handoff is explicitly turned off (Linux).
    if (string.eql(m.network.expose, "public") && m.network.portBase > 0) {
        s.basePort = m.network.portBase;
        s.portFlag = m.network.portFlag;
        s.probePort = m.network.portBase;
        return s;
    }
    if (m.lb.handoff) {
        s.handoff = true;
        s.handoffSock = `/tmp/nova-${m.metadata.name}.sock`;
        s.servicePort = if (m.network.servicePort > 0) m.network.servicePort else 8080;
        return s;
    }
    let mode = isolationMode(m);
    if (string.eql(mode, "netns")) {
        // Linux gateway-only: each replica runs in its own netns and binds the SAME port on its private
        // address; the supervisor advertises the private addresses. Port defaults to 8080 if unset.
        s.netns = true;
        s.basePort = if (m.network.portBase > 0) m.network.portBase else 8080;
        s.portFlag = if (!string.eql(m.network.portFlag, "")) m.network.portFlag else "--port";
        s.probePort = s.basePort;
    }
    // handoff (mac/win) and loopback leave basePort 0 — the app is reached via the gateway, not a port.
    return s;
}

// The Spec for the workload's SERVICE (gateway) process — the data-plane side orchd launches alongside
// the app replicas. It runs the `service` binary at `servicePath` in fd-handoff mode on the SAME
// rendezvous the apps connect to (/tmp/nova-<name>.sock), listening on network.servicePort. Run it via a
// supervisor exactly like an app: the handoff Spec makes the supervisor set NOVA_HANDOFF_SOCK + NOVA_PORT
// for the service child. Only meaningful when the workload is handoff (lb.handoff); returns a service
// Spec regardless, so the caller gates on toSpec(m).handoff.
pub fn serviceSpecFor(m: Manifest, servicePath: string): spec.Spec {
    let s = spec.Spec(m.metadata.name + "-svc", servicePath);
    s.replicas = 1;
    s.restartPolicy = "always";
    s.handoff = true;
    s.handoffSock = `/tmp/nova-${m.metadata.name}.sock`;
    s.basePort = if (m.network.servicePort > 0) m.network.servicePort else 8080;
    return s;
}

// Which isolation mechanism a gateway-only app uses on THIS host. The manifest declares the INTENT
// (network.expose = gateway-only); the platform picks the implementation, the same way the reactor
// backend is picked per OS:
//   "handoff" — macOS/Windows: the app receives client sockets over the gateway's AF_UNIX rendezvous
//               and has no listening TCP port (fd-passing).
//   "netns"   — Linux with netns available: the app runs in its own network namespace behind a veth
//               pair, reachable only at its private address (see net/netns).
//   "loopback"— gateway-only but netns unavailable on Linux (no root/ip): bind loopback only, best effort.
//   "public"  — network.expose = public: the app binds a host port directly (dev convenience).
pub fn isolationMode(m: Manifest): string {
    if (string.eql(m.network.expose, "public")) { return "public"; }
    if (platform.isLinux) { return if (netns.available()) "netns" else "loopback"; }
    return "handoff";
}

// The Linux network plan for a gateway-only app at replica slot `idx` (its private /30 + veth names).
// Only meaningful when isolationMode(m) == "netns".
pub fn netPlanFor(m: Manifest, idx: int): netns.NetPlan {
    return netns.plan(m.metadata.name, idx);
}

// Build the load-balancer Pool the gateway fronts this app with, straight from the manifest: the LB
// strategy and the active health-check policy. Backends are added by autoscalerFrom (which pre-registers
// the replica slots) or by service discovery — poolFrom only sets policy.
pub fn poolFrom(m: Manifest): proxy.Pool {
    let p = proxy.Pool();
    p.setStrategy(proxy.strategyFromName(m.lb.strategy));
    p.setHealthPath(m.health.path);
    p.enableHealthChecks(m.health.intervalMs, m.health.timeoutMs, m.health.rise, m.health.fall);
    return p;
}

// Build the control-plane autoscaler for this app over `pool`: the replica band [replicas.min,
// replicas.max], the process command, the advertise host, and the exposure base port; then load the PID
// gains and setpoint from autoscale.*. The Autoscaler constructor pre-registers replicas.max drained
// pool slots (host:portBase+i), so after this the pool knows every slot the controller can scale into.
// The caller runs the control loop only when m.autoscale.enabled (min == max otherwise pins the count).
pub fn autoscalerFrom(m: Manifest, pool: proxy.Pool, host: string): autoscale.Autoscaler {
    let base = if (m.network.portBase > 0) m.network.portBase else 0;
    let a = autoscale.Autoscaler(pool, m.workload.binary, host, base, m.replicas.min, m.replicas.max);
    a.configure(m.autoscale.kp, m.autoscale.ki, m.autoscale.kd, m.autoscale.setpoint);
    return a;
}
