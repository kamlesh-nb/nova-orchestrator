// orch/backup.nova -- O3: logical backup/restore of the config store's key/value state. A line-oriented
// dump (`key<TAB>value` per line) of every entry under a prefix; restore re-applies them via put. Built on
// the ConfigStore list/put seam, so it works over the in-memory oracle (tests) and the live SqlConfigStore
// alike -- a CLIENT-side logical backup (the btree TIER's physical page snapshot is D6/D7). Config values
// here (lease rows, JSON workload specs) are tab/newline-free, which the line format assumes.
import store.config;
import list;
import string;

// Serialize every entry under `prefix` to a `key<TAB>value` dump (deterministic: store.list order).
pub fn dump(store: config.ConfigStore, prefix: string): string {
    let out = "";
    let entries = store.list(prefix);
    let i = 0;
    while (i < entries.size()) {
        let e = entries.get(i) ?? config.ConfigEntry("", "", 0);
        out = out + e.key + "\t" + e.value + "\n";
        i = i + 1;
    }
    return out;
}

// Restore a dump into `store` via put (last-writer-wins). Returns the number of entries applied.
pub fn restore(store: config.ConfigStore, data: string): int {
    let n = 0;
    let lines = string.split(data, "\n");
    let i = 0;
    while (i < lines.size()) {
        let ln = lines.get(i) ?? "";
        if (!string.eql(ln, "")) {
            let tab = string.indexOf(ln, "\t");
            if (tab > 0) {
                let key = string.slice(ln, 0, tab);
                let val = string.slice(ln, tab + 1, string.len(ln));
                let _ = store.put(key, val);
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}
