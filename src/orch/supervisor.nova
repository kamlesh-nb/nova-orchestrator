// orch/supervisor.nova — keeps ONE workload's replica set running (I2 native orchestrator).
//
// A Supervisor owns N replica processes for a Spec. It is driven by the nativelet's reconcile loop (no
// per-supervisor thread, unlike the Zig PoC): every tick, `poll()` reaps exited replicas and restarts
// them per the Spec's restart policy, and `ensureReplicas()` tops up / trims to the desired count.
// Non-blocking throughout — it uses Process.tryWait (waitpid WNOHANG), never the blocking wait, so a
// single async reconcile coroutine can supervise many workloads. Graceful stop is SIGTERM → brief grace
// → SIGKILL.

import process;
import list;
import string;
import orch.spec;
import orch.isolation;
import os.sandbox;
import net.netns;
import env;

pub struct Supervisor {
    pub spec: spec.Spec,
    pub procs: list.List<process.Process>,  // live replica processes
    // Port assigned to each live replica (parallel to procs; -1 = none). When spec.basePort > 0 and
    // spec.portFlag is set, each replica is spawned with a DISTINCT port from [basePort, ...] so the
    // endpoints orchd advertises are actually served. Kept in lockstep with procs on spawn/reap/kill.
    pub ports: list.List<int>,
    // Per-replica netns /30 slot (parallel to procs; empty unless spec.netns). Each live replica owns a
    // network namespace + veth pair identified by its slot; kept in lockstep with procs on spawn/kill.
    pub netnsSlots: list.List<int>,
    // Rolling count of restarts performed (observability / test signal).
    pub restarts: int,
    // When false (tests), the lifecycle methods manipulate no real processes — they no-op so the pure
    // policy logic can be exercised without spawning binaries.
    pub manageProcesses: bool,
    // O6 lifecycle simulation: when true, the replica set is VIRTUAL -- one int per replica in simReplicas
    // (-2 = running, else the exit code of a pending crash). spawn/kill/poll/ensureReplicas/running all
    // operate on it deterministically, so crash loops, restart policy, and rescale-at-scale are exercised
    // in-process without spawning binaries (no timing races, unlike real processes). Injected via simCrash.
    pub simulated: bool,
    pub simReplicas: list.List<int>,
    init(sp: spec.Spec) {
        self.spec = sp;
        self.procs = list.List<process.Process>();
        self.ports = list.List<int>();
        self.netnsSlots = list.List<int>();
        self.restarts = 0;
        self.manageProcesses = true;
        self.simulated = false;
        self.simReplicas = list.List<int>();
    }

    fn portInUse(self: Supervisor, p: int): bool {
        let i = 0;
        while (i < self.ports.size()) {
            if ((self.ports.get(i) ?? -1) == p) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Lowest port at/above basePort not currently assigned to a live replica (so a replica restarted after
    // a middle death reclaims the freed port instead of colliding with a survivor). -1 when not exposed.
    fn nextFreePort(self: Supervisor): int {
        if (self.spec.basePort <= 0 || string.eql(self.spec.portFlag, "")) { return -1; }
        let p = self.spec.basePort;
        while (self.portInUse(p)) { p = p + 1; }
        return p;
    }

    fn slotInUse(self: Supervisor, s: int): bool {
        let i = 0;
        while (i < self.netnsSlots.size()) {
            if ((self.netnsSlots.get(i) ?? -1) == s) { return true; }
            i = i + 1;
        }
        return false;
    }
    // Lowest netns /30 slot at/above netnsBase not held by a live replica (reclaims a freed slot after a
    // middle death, like nextFreePort). Each replica gets its own namespace + /30.
    fn nextFreeNetnsSlot(self: Supervisor): int {
        let s = self.spec.netnsBase;
        while (self.slotInUse(s)) { s = s + 1; }
        return s;
    }

    fn spawnOne(self: Supervisor): void {
        if (self.simulated) {
            self.simReplicas.push(-2);                 // a fresh running virtual replica
            self.ports.push(self.nextFreePort());
            return;
        }
        if (!self.manageProcesses) { return; }

        // fd-passing handoff (the default): spawn the replica with NOVA_HANDOFF_SOCK set to the workload's
        // rendezvous, so app.run connects to the service and receives client sockets there instead of
        // binding a TCP port. The env var is set immediately before the (synchronous) spawn — the child
        // captures it at exec — then cleared so a later non-handoff spawn does not inherit it.
        if (self.spec.handoff) {
            let hargs = list.List<string>();
            let k = 0;
            while (k < self.spec.args.size()) { hargs.push(self.spec.args.get(k) ?? ""); k = k + 1; }
            env.set("NOVA_HANDOFF_SOCK", self.spec.handoffSock);
            let hp = process.Process.spawn(self.spec.binaryPath, hargs);
            env.set("NOVA_HANDOFF_SOCK", "");
            let _ = isolation.applyLimits(self.spec, hp.pid());
            self.procs.push(hp);
            self.ports.push(-1);            // no host port in handoff mode
            return;
        }

        // netns isolation (Linux gateway-only): each replica runs in its own network namespace behind a
        // veth pair and binds the SAME basePort on its private address, so replicas need no distinct host
        // port. Launch the binary INSIDE the namespace via `ip netns exec` (netns.wrapExec). On non-Linux
        // netns.setup is a no-op and this path should not be selected (toSpec only sets netns on Linux).
        if (self.spec.netns) {
            let slot = self.nextFreeNetnsSlot();
            let plan = netns.plan(self.spec.name, slot);
            let _ = netns.teardown(plan);              // clear any stale namespace from a prior run
            let _ = netns.setup(plan);
            let nargs = list.List<string>();
            let j = 0;
            while (j < self.spec.args.size()) { nargs.push(self.spec.args.get(j) ?? ""); j = j + 1; }
            if (self.spec.basePort > 0 && !string.eql(self.spec.portFlag, "")) {
                nargs.push(self.spec.portFlag);
                nargs.push(`${self.spec.basePort}`);
            }
            let cmdArgs = netns.wrapExec(plan, self.spec.binaryPath, nargs);
            let np = process.Process.spawn("ip", cmdArgs);
            let _ = isolation.applyLimits(self.spec, np.pid());
            self.procs.push(np);
            self.ports.push(self.spec.basePort);       // every replica shares basePort (disjoint netns)
            self.netnsSlots.push(slot);
            return;
        }

        let port = self.nextFreePort();
        // Build argv: the spec args plus the assigned port flag when this workload is directly exposed.
        let args = self.spec.args;
        if (port >= 0) {
            args = list.List<string>();
            let i = 0;
            while (i < self.spec.args.size()) { args.push(self.spec.args.get(i) ?? ""); i = i + 1; }
            args.push(self.spec.portFlag);
            args.push(`${port}`);
        }
        // I4: isolationLevel>0 clone()s the child into namespaces + rootfs + dropped caps (+ seccomp at
        // level 3); level 0 is a plain spawn. Linux-only — degrades to a plain spawn elsewhere.
        let p = if (self.spec.isolationLevel <= 0)
                    process.Process.spawn(self.spec.binaryPath, args)
                else if (self.spec.isolationLevel >= 3)
                    sandbox.spawn(self.spec.binaryPath, args, sandbox.level3(self.spec.rootfs, self.spec.name))
                else
                    sandbox.spawn(self.spec.binaryPath, args, sandbox.level1(self.spec.rootfs, self.spec.name));
        // Apply cgroups-v2 limits (Linux; best-effort no-op elsewhere) to the freshly-spawned child.
        let _ = isolation.applyLimits(self.spec, p.pid());
        self.procs.push(p);
        self.ports.push(port);
    }

    // SIGTERM a replica, give it a brief grace window (polling for exit), then SIGKILL if still alive,
    // reap, and free. Blocking wait is avoided — the grace loop polls tryWait.
    fn stopProc(self: Supervisor, p: process.Process): void {
        let _ = p.terminate();                 // SIGTERM
        let tries = 0;
        while (tries < 50) {                   // ~50 polls; caller paces via reconcile cadence anyway
            if (p.tryWait() != -2) { break; }  // exited
            tries = tries + 1;
        }
        if (p.tryWait() == -2) { let _ = p.forceKill(); }  // still alive → SIGKILL
        let _ = p.wait();                       // reap (returns immediately once dead)
        p.close();
    }

    fn killLast(self: Supervisor): void {
        if (self.simulated) {
            let m = self.simReplicas.size();
            if (m == 0) { return; }
            self.simReplicas.remove(m - 1);
            if (m - 1 < self.ports.size()) { self.ports.remove(m - 1); }
            return;
        }
        let n = self.procs.size();
        if (n == 0) { return; }
        let idx = n - 1;
        if (self.manageProcesses) {
            let p = self.procs.get(idx) ?? process.Process.spawn("/bin/true", list.List<string>());
            self.stopProc(p);
        }
        self.procs.remove(idx);
        if (idx < self.ports.size()) { self.ports.remove(idx); }
        // Tear down this replica's network namespace + veth (netns mode; no-op off Linux).
        if (self.spec.netns && idx < self.netnsSlots.size()) {
            let slot = self.netnsSlots.get(idx) ?? -1;
            if (slot >= 0 && self.manageProcesses) { let _ = netns.teardown(netns.plan(self.spec.name, slot)); }
            self.netnsSlots.remove(idx);
        }
    }

    // Bring the running replica count to spec.replicas (spawn up, stop down). Called on start and on any
    // scale change.
    pub fn ensureReplicas(self: Supervisor): void {
        if (!self.manageProcesses && !self.simulated) { return; }
        while (self.running() < self.spec.replicas) { self.spawnOne(); }
        while (self.running() > self.spec.replicas) { self.killLast(); }
    }

    pub fn start(self: Supervisor): void { self.ensureReplicas(); }

    // Reap any exited replicas and restart them per policy. Non-blocking (tryWait). A replica that exits
    // under an "always"/"on-failure" policy is replaced (counting a restart); under "never" it stays
    // gone. After reaping, top back up to spec.replicas for restart policies (a crash under "always"
    // must return to N even if several died at once).
    pub fn poll(self: Supervisor): void {
        if (self.simulated) {
            // Reap crashed virtual replicas (code != -2) and restart per policy, mirroring the real path.
            let k = 0;
            while (k < self.simReplicas.size()) {
                let code = self.simReplicas.get(k) ?? -2;
                if (code == -2) {
                    k = k + 1;                               // still running
                } else {
                    self.simReplicas.remove(k);
                    if (k < self.ports.size()) { self.ports.remove(k); }
                    if (spec.shouldRestart(self.spec.restartPolicy, code)) {
                        self.spawnOne();                     // respawn (appended at the end)
                        self.restarts = self.restarts + 1;
                    }
                    // k unchanged: re-examine the element that shifted into this slot
                }
            }
            return;
        }
        if (!self.manageProcesses) { return; }
        let i = 0;
        while (i < self.procs.size()) {
            let p = self.procs.get(i) ?? process.Process.spawn("/bin/true", list.List<string>());
            let st = p.tryWait();
            if (st == -2) {
                i = i + 1;                       // still running
            } else {
                // exited (st = code) or errored (-1) → reap + drop this slot (and free its port)
                p.close();
                self.procs.remove(i);
                if (i < self.ports.size()) { self.ports.remove(i); }
                if (spec.shouldRestart(self.spec.restartPolicy, st)) {
                    self.spawnOne();             // replace (pushed at the end; don't advance i)
                    self.restarts = self.restarts + 1;
                }
                // i unchanged: re-examine the element that shifted into this slot
            }
        }
    }

    // Stop ALL replicas (graceful). Leaves procs empty.
    pub fn stopAll(self: Supervisor): void {
        if (self.simulated) {
            while (self.simReplicas.size() > 0) { self.simReplicas.remove(self.simReplicas.size() - 1); }
        } else if (self.manageProcesses) {
            while (self.procs.size() > 0) { self.killLast(); }
        } else {
            while (self.procs.size() > 0) { self.procs.remove(self.procs.size() - 1); }
        }
        while (self.ports.size() > 0) { self.ports.remove(self.ports.size() - 1); }
    }

    pub fn running(self: Supervisor): int {
        if (self.simulated) {
            // Count only HEALTHY virtual replicas (-2); a crashed-but-not-yet-reaped slot is not running,
            // so a crash shows as under-provisioned until the next poll() reaps + restarts it.
            let n = 0;
            let i = 0;
            while (i < self.simReplicas.size()) {
                if ((self.simReplicas.get(i) ?? 0) == -2) { n = n + 1; }
                i = i + 1;
            }
            return n;
        }
        return self.procs.size();
    }

    // Simulation-only: crash the last `count` running virtual replicas with exit `code`, so the next poll()
    // reaps them and (per restart policy) restarts them -- driving the restart counter deterministically.
    // A no-op unless simulated. Use code 0 for a clean exit, nonzero for a failure.
    pub fn simCrash(self: Supervisor, count: int, code: int): void {
        if (!self.simulated) { return; }
        let remaining = count;
        let i = self.simReplicas.size() - 1;
        while (i >= 0 && remaining > 0) {
            if ((self.simReplicas.get(i) ?? -2) == -2) {
                self.simReplicas.set(i, code);
                remaining = remaining - 1;
            }
            i = i - 1;
        }
    }

    // The service endpoints this workload ADVERTISES on `host` -- the desired topology (pure; see
    // spec.serviceEndpoints). orchd publishes these to the discovery file; service health-checks liveness.
    pub fn advertisedEndpoints(self: Supervisor, host: string): list.List<string> {
        // Handoff mode: nothing to advertise — the service reaches the apps over the AF_UNIX rendezvous
        // (they register by connecting to it), not via host:port discovery.
        if (self.spec.handoff) { return list.List<string>(); }
        // netns mode: each replica is reachable at its PRIVATE veth address (10.66.<slot>.2) on basePort,
        // regardless of `host` — the gateway is on the same node and forwards to those addresses.
        if (self.spec.netns) {
            let out = list.List<string>();
            let i = 0;
            while (i < self.netnsSlots.size()) {
                let slot = self.netnsSlots.get(i) ?? -1;
                if (slot >= 0) {
                    let plan = netns.plan(self.spec.name, slot);
                    out.push(`${plan.appIp}:${self.spec.basePort}`);
                }
                i = i + 1;
            }
            return out;
        }
        return spec.serviceEndpoints(self.spec, host);
    }
}
