// store/sqlconfig.nova -- the BTreeDB-backed config store (P1 live path).
//
// SqlConfigStore is the async, SQL-backed sibling of the in-memory ConfigStore (store/config.nova): same
// etcd-shaped semantics (monotonic global revision, per-key mod-revision, prefix list, CAS on revision,
// delete, watch-since), but persisted through the async data.db seam (trait Connection) so it runs over
// the nova-btreedb driver against a live server. ConfigStore stays the offline reference/oracle; this is
// the path the orchestrator actually reconciles from once a DB is attached.
//
// Storage model (two tables):
//   config(k TEXT PRIMARY KEY, v TEXT, revision INT)   -- the KV space; `revision` = etcd mod_revision
//   config_meta(id INT PRIMARY KEY, rev INT)           -- one row (id 0): the monotonic global revision
// The global revision is a single-writer read-modify-write on config_meta (the leader is the only writer,
// and BTreeDB serialises writers), so it never goes backwards even across deletes -- unlike MAX(revision),
// which a delete of the max key would rewind and thereby break watch(sinceRevision).
//
// list()/watch() do a full scan + Nova-side prefix filter rather than SQL range/LIKE predicates: a config
// store holds few keys, and this keeps correctness independent of which WHERE/ORDER features the engine
// supports. Parameters are passed as List<DbValue> (the driver does client-side $N substitution).

import db;
import list;
import string;
import datetime;
import store.config;

pub struct SqlConfigStore {
    conn: Connection,

    init(conn: Connection) {
        self.conn = conn;
    }

    // Create the config + meta tables and seed the revision counter. Idempotent enough for a single-writer
    // bootstrap (a re-run's CREATE/seed is a harmless no-op on an existing store).
    pub async fn ensureSchema(self: SqlConfigStore): void {
        let none = list.List<DbValue>();
        let _1 = await self.conn.exec("CREATE TABLE config (k TEXT PRIMARY KEY, v TEXT, revision INT, updated_by TEXT, updated_at INT)", none);
        let none2 = list.List<DbValue>();
        let _2 = await self.conn.exec("CREATE TABLE config_meta (id INT PRIMARY KEY, rev INT)", none2);
        // Seed the single counter row at 0 only if it is not already there.
        let sel = list.List<DbValue>();
        let cur = await self.conn.query("SELECT rev FROM config_meta WHERE id = 0", sel);
        if (cur.rowCount() == 0) {
            let seed = list.List<DbValue>();
            let _3 = await self.conn.exec("INSERT INTO config_meta (id, rev) VALUES (0, 0)", seed);
        }
    }

    // Bump the global revision and return the new value. Read-modify-write with an explicit value rather
    // than `SET rev = rev + 1`: BTreeDB's UPDATE does not evaluate a column-referencing expression (it
    // returns an empty tag / 0 rows). Single writer, so the read then write is race-free.
    async fn nextRevision(self: SqlConfigStore): int {
        let sel = list.List<DbValue>();
        let rs = await self.conn.query("SELECT rev FROM config_meta WHERE id = 0", sel);
        let cur = if (rs.rowCount() == 0) 0 else rs.row(0).getInt(0);
        let next = cur + 1;
        let up = list.List<DbValue>();
        up.push(dbInt(next));
        let _1 = await self.conn.exec("UPDATE config_meta SET rev = $1 WHERE id = 0", up);
        return next;
    }

    // Declare this node's fencing epoch to the underlying BTreeDB (over the wire): the store then rejects
    // any client MUTATION stamped below the highest epoch it has seen. Called by the leader lease on
    // promotion so the store's write-fence rises with the lease epoch. "SET FENCE EPOCH n" is a control
    // command intercepted by the btree executor (it is never itself fenced).
    pub async fn setWriteEpoch(self: SqlConfigStore, epoch: long): void {
        let none = list.List<DbValue>();
        let _1 = await self.conn.exec("SET FENCE EPOCH " + epoch, none);
    }

    // Current global revision (0 on an empty store).
    pub async fn revision(self: SqlConfigStore): long {
        let none = list.List<DbValue>();
        let rs = await self.conn.query("SELECT rev FROM config_meta WHERE id = 0", none);
        if (rs.rowCount() == 0) { return 0; }
        return rs.row(0).getInt(0) as long;
    }

    // Unconditional write by the default actor ("system"). See putBy for the audit trail.
    pub async fn put(self: SqlConfigStore, key: string, value: string): long {
        return await self.putBy(key, value, "system");
    }

    // Unconditional write WITH an audit trail: `by` = the actor identity, stamped alongside updated_at =
    // datetime.now() (unix seconds, read from the real clock on this live path). Bumps the global revision,
    // upserts the key at that revision, returns it. Audit columns are APPENDED after revision so the first
    // three parameter positions match the pre-audit statements.
    pub async fn putBy(self: SqlConfigStore, key: string, value: string, by: string): long {
        let rev = await self.nextRevision();
        let at = datetime.now();            // unix seconds, from the real clock on this live path
        // UPSERT = UPDATE, and INSERT only if it matched nothing (BTreeDB has no ON CONFLICT; single
        // writer makes the update-then-insert race-free).
        let up = list.List<DbValue>();
        up.push(dbText(value));
        up.push(dbInt(rev));
        up.push(dbText(by));
        up.push(dbInt(at));
        up.push(dbText(key));
        let ex = await self.conn.exec("UPDATE config SET v = $1, revision = $2, updated_by = $3, updated_at = $4 WHERE k = $5", up);
        if (ex.rows_affected == 0) {
            let ins = list.List<DbValue>();
            ins.push(dbText(key));
            ins.push(dbText(value));
            ins.push(dbInt(rev));
            ins.push(dbText(by));
            ins.push(dbInt(at));
            let _1 = await self.conn.exec("INSERT INTO config (k, v, revision, updated_by, updated_at) VALUES ($1, $2, $3, $4, $5)", ins);
        }
        return rev as long;
    }

    // Read a key. Returns the entry, or undefined if absent.
    pub async fn get(self: SqlConfigStore, key: string): config.ConfigEntry | undefined {
        let p = list.List<DbValue>();
        p.push(dbText(key));
        let rs = await self.conn.query("SELECT v, revision, updated_by, updated_at FROM config WHERE k = $1", p);
        if (rs.rowCount() == 0) { return undefined; }
        let r = rs.row(0);
        let e = config.ConfigEntry(key, r.getText(0), r.getInt(1) as long);
        e.updatedBy = r.getText(2);
        e.updatedAt = r.getLong(3);
        return e;
    }

    pub async fn exists(self: SqlConfigStore, key: string): bool {
        let p = list.List<DbValue>();
        p.push(dbText(key));
        let rs = await self.conn.query("SELECT revision FROM config WHERE k = $1", p);
        return rs.rowCount() > 0;
    }

    // All entries whose key starts with `prefix` (full scan + Nova-side filter; see file header).
    pub async fn list(self: SqlConfigStore, prefix: string): list.List<config.ConfigEntry> {
        let out = list.List<config.ConfigEntry>();
        let none = list.List<DbValue>();
        let rs = await self.conn.query("SELECT k, v, revision, updated_by, updated_at FROM config", none);
        let i = 0;
        while (i < rs.rowCount()) {
            let r = rs.row(i);
            let k = r.getText(0);
            if (string.startsWith(k, prefix)) {
                let e = config.ConfigEntry(k, r.getText(1), r.getInt(2) as long);
                e.updatedBy = r.getText(3);
                e.updatedAt = r.getLong(4);
                out.push(e);
            }
            i = i + 1;
        }
        return out;
    }

    // Compare-and-set on revision. expectedRevision 0 = create-only (must be absent). Returns the new
    // revision on success, or -1 on a mismatch (nothing written). The leader-lease / safe-write primitive.
    pub async fn cas(self: SqlConfigStore, key: string, value: string, expectedRevision: long): long {
        return await self.casBy(key, value, expectedRevision, "system");
    }

    // CAS with an audit trail (see putBy for the `by` / updated_at contract).
    pub async fn casBy(self: SqlConfigStore, key: string, value: string, expectedRevision: long, by: string): long {
        let at = datetime.now();            // unix seconds, from the real clock on this live path
        if (expectedRevision == 0) {
            let has = await self.exists(key);
            if (has) { return -1 as long; }         // create-only: must not already exist
            let rev = await self.nextRevision();
            let ins = list.List<DbValue>();
            ins.push(dbText(key));
            ins.push(dbText(value));
            ins.push(dbInt(rev));
            ins.push(dbText(by));
            ins.push(dbInt(at));
            let _1 = await self.conn.exec("INSERT INTO config (k, v, revision, updated_by, updated_at) VALUES ($1, $2, $3, $4, $5)", ins);
            return rev as long;
        }
        // Guarded update: read the current revision and only bump + write if it STILL matches. Checking
        // before bumping (rather than a single UPDATE ... WHERE revision = ?) means a FAILED CAS consumes
        // no revision, so this matches the in-memory ConfigStore's numbering exactly (single writer, so
        // no TOCTOU between the read and the write).
        let chk = list.List<DbValue>();
        chk.push(dbText(key));
        let rs = await self.conn.query("SELECT revision FROM config WHERE k = $1", chk);
        if (rs.rowCount() == 0) { return -1 as long; }                     // key gone
        if (rs.row(0).getInt(0) != (expectedRevision as int)) { return -1 as long; }  // stale -> retry
        let rev2 = await self.nextRevision();
        let up = list.List<DbValue>();
        up.push(dbText(value));
        up.push(dbInt(rev2));
        up.push(dbText(by));
        up.push(dbInt(at));
        up.push(dbText(key));
        let _1 = await self.conn.exec("UPDATE config SET v = $1, revision = $2, updated_by = $3, updated_at = $4 WHERE k = $5", up);
        return rev2 as long;
    }

    // Remove a key. Bumps the global revision iff something was deleted. Returns whether it existed.
    pub async fn del(self: SqlConfigStore, key: string): bool {
        let p = list.List<DbValue>();
        p.push(dbText(key));
        let ex = await self.conn.exec("DELETE FROM config WHERE k = $1", p);
        if (ex.rows_affected > 0) {
            let _1 = await self.nextRevision();       // advance so a watcher sees the store moved on
            return true;
        }
        return false;
    }

    // Poll-based watch: every entry under `prefix` written after sinceRevision (full scan + filter).
    pub async fn watch(self: SqlConfigStore, prefix: string, sinceRevision: long): list.List<config.ConfigEvent> {
        let out = list.List<config.ConfigEvent>();
        let none = list.List<DbValue>();
        let rs = await self.conn.query("SELECT k, v, revision, updated_by, updated_at FROM config", none);
        let i = 0;
        while (i < rs.rowCount()) {
            let r = rs.row(i);
            let k = r.getText(0);
            let rev = r.getInt(2) as long;
            if (string.startsWith(k, prefix)) {
                if (rev > sinceRevision) {
                    out.push(config.ConfigEvent(k, r.getText(1), rev, false));
                }
            }
            i = i + 1;
        }
        return out;
    }
}
