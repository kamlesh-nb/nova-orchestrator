<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd daemon for Kyte orchd. install.sh substitutes @BIN_DIR@/@CONF_DIR@/@DATA_DIR@/@LOG_DIR@.
     orchd supervises replicas; it runs as root (LaunchDaemons run as root by default). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ky.orchd</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BIN_DIR@/orchd</string>
        <string>@CONF_DIR@/orchd.json</string>
    </array>
    <key>WorkingDirectory</key><string>@DATA_DIR@</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>@LOG_DIR@/orchd.log</string>
    <key>StandardErrorPath</key><string>@LOG_DIR@/orchd.log</string>
</dict>
</plist>
