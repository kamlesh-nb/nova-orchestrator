// Offline tests for the NSX views + the manifest->ServiceView mapping (pure; no live store/server needed).
// The store's live methods are exercised end-to-end in the browser; here we prove the mapping and that the
// views emit the expected Datastar attributes and structure.
import assert;
import string;
import list;
import Domain.entities.cluster;
import Features.ControlPlane.Shared.store;
import Features.ControlPlane.views.tree;
import Features.ControlPlane.views.detail;

fn shopYaml(): string {
    return "metadata:\n  name: shop\nworkload:\n  binary: ./bin/webapp\n"
        + "replicas:\n  min: 3\n  max: 6\nautoscale:\n  enabled: true\n  metric: inflight\n  setpoint: 8\n"
        + "lb:\n  strategy: roundrobin\n  handoff: true\nnetwork:\n  expose: gateway-only\n  servicePort: 8140\n"
        + "routes:\n  - /api/products\n";
}

@test
fn test_view_of_manifest(): void {
    let sv = store.viewOf(shopYaml());
    assert.equalStr(sv.name, "shop");
    assert.equalInt(sv.replicasMin, 3);
    assert.isTrue(sv.handoff);
    assert.equalStr(sv.isolation, "handoff");
    assert.equalInt(sv.replicas.size(), 3);
    assert.isTrue(string.contains(sv.routesCsv, "/api/products"));
}

@test
fn test_tree_view_is_datastar_nsx(): void {
    let nodes = list.List<cluster.NodeView>();
    nodes.push(cluster.NodeView("node-1", "127.0.0.1"));
    let svcs = list.List<cluster.ServiceView>();
    svcs.push(store.viewOf(shopYaml()));
    let html = tree.treeView(nodes, svcs, "", "");
    assert.isTrue(string.contains(html, "id=\"tree\""));                       // patch target
    assert.isTrue(string.contains(html, "<details open"));                     // collapsible (open="" valueless attr)
    assert.isTrue(string.contains(html, "class=\"twig"));                      // dotted level guides
    assert.isTrue(string.contains(html, "data-on:click__stop=\"@get('/api/services/shop')\""));  // colon Datastar
    assert.isTrue(string.contains(html, "data-on:click__stop=\"@get('/api/nodes/node-1')\""));
}

@test
fn test_detail_views(): void {
    let sv = store.viewOf(shopYaml());
    let sp = detail.servicePanel(sv);
    assert.isTrue(string.contains(sp, "id=\"detail\""));
    assert.isTrue(string.contains(sp, "data-on:submit=\"@post('/api/services')\""));    // form submit
    assert.isTrue(string.contains(sp, "data-signals="));                                 // seeded signals
    assert.isTrue(string.contains(sp, "data-bind=\"svcName\""));                         // input binding
    assert.isTrue(string.contains(sp, "@post('/api/services/shop/teardown')"));          // teardown action
    let np = detail.nodePanel(cluster.NodeView("node-1", "127.0.0.1"), 3);
    assert.isTrue(string.contains(np, "Node information"));
    assert.isTrue(string.contains(np, "@get('/api/nodes/node-1/new')"));                 // deploy button
}
