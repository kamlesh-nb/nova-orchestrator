// orchweb -- the web control plane of the orchestrator stack, as a standard Kyte web app (`kyte init web`
// layout: static wwwroot/index.html shell + vertical-slice Features + a composition root). It is the
// writable, browser-facing operator surface: a Tailwind + Datastar dashboard whose sidebar is a collapsible
// tree of nodes -> services -> replica slots. Clicking a service loads its complete manifest as an editable
// form; clicking a node loads its info + a deploy screen. Every deploy / teardown writes a manifest to the
// SAME artifactd config store kynatord reconciles from, so the fleet actually changes.
//
// The shell (wwwroot/index.html) is static and served via useStatic; each slice's handler returns a Datastar
// SSE fragment that the shell morphs into #tree / #detail / #toast. Handlers are plain RouteHandler structs
// registered in buildApp; each holds its ControlPlane dependency, passed in at construction.
//
//   orchweb   # KYTE_ORCHWEB_STORE (default http://127.0.0.1:8135, artifactd's /cfg surface),
//             # KYTE_ORCHWEB_TOKEN (deploy bearer token; default empty),
//             # KYTE_ORCHWEB_NODE (default node-1), KYTE_PORT (default 8130)
import web.app;
import string;
import env;
import Features.ControlPlane.Shared.repo;
import Features.ControlPlane.GetTree.handler;
import Features.ControlPlane.GetService.handler;
import Features.ControlPlane.GetNode.handler;
import Features.ControlPlane.NewServiceForm.handler;
import Features.ControlPlane.DeployService.handler;
import Features.ControlPlane.TeardownService.handler;

fn buildApp(base: string, token: string, nodeId: string, advertise: string): App {
    let app = App();

    // One ControlPlane repository, shared by every handler (constructor injection at the composition root).
    let cp = repo.ControlPlane(base, token, nodeId, advertise);

    app.get("/api/tree", GetTreeHandler(cp));
    app.get("/api/services/{name}", GetServiceHandler(cp));
    app.get("/api/nodes/{id}", GetNodeHandler(cp));
    app.get("/api/nodes/{id}/new", NewServiceFormHandler(cp));
    app.post("/api/services", DeployServiceHandler(cp));
    app.post("/api/services/{name}/teardown", TeardownServiceHandler(cp));

    app.useStatic("/", "./wwwroot");
    return app;
}

fn main(): void {
    let base = env.get("KYTE_ORCHWEB_STORE");
    if (string.eql(base, "")) { base = "http://127.0.0.1:8135"; }
    let token = env.get("KYTE_ORCHWEB_TOKEN");
    let nodeId = env.get("KYTE_ORCHWEB_NODE");
    if (string.eql(nodeId, "")) { nodeId = "node-1"; }
    let advertise = env.get("KYTE_ORCHWEB_ADVERTISE");
    if (string.eql(advertise, "")) { advertise = "127.0.0.1"; }
    let port = 8130;
    let pe = env.get("KYTE_PORT");
    if (!string.eql(pe, "")) { port = string.parseI64(pe) as int; }

    let app = buildApp(base, token, nodeId, advertise);
    console.log(`orchweb: control plane on http://127.0.0.1:${port} (store ${base})`);
    app.run(port);
}
