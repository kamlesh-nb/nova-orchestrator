// Loads a service's manifest editor into #detail. The service name is the {name} route parameter.
import web.response;
import web.routing;
import Features.ControlPlane.Shared.repo;
import Features.ControlPlane.Shared.sse;
import Features.ControlPlane.views.detail;

pub struct GetServiceHandler impl RouteHandler {
    cp: repo.ControlPlane,
    init(cp: repo.ControlPlane) { self.cp = cp; }
    async fn serve(self: GetServiceHandler, ctx: routing.Context): Response {
        let name = ctx.param("name");
        return await sse.one(detail.servicePanel(await self.cp.service(name)));
    }
}
