// Loads the new-service (deploy) form into #detail for a node. The node id is the {id} route parameter.
import web.response;
import web.routing;
import Features.ControlPlane.Shared.repo;
import Features.ControlPlane.Shared.sse;
import Features.ControlPlane.views.detail;

pub struct NewServiceFormHandler impl RouteHandler {
    cp: repo.ControlPlane,
    init(cp: repo.ControlPlane) { self.cp = cp; }
    async fn serve(self: NewServiceFormHandler, ctx: routing.Context): Response {
        let id = ctx.param("id");
        return await sse.one(detail.deployPanel(await self.cp.node(id)));
    }
}
