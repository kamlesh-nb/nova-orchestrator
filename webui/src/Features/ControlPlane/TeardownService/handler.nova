// Deletes a service's desired state, then refreshes the tree, resets the detail panel, and reports the result.
import string;
import list;
import web.response;
import Features.ControlPlane.TeardownService.command;
import Features.ControlPlane.Shared.store;
import Features.ControlPlane.Shared.sse;
import Features.ControlPlane.views.tree;
import Features.ControlPlane.views.detail;

pub struct TeardownServiceHandler impl RequestHandler<TeardownService, Response> {
    cp: store.ControlPlane,
    init(cp: store.ControlPlane) { self.cp = cp; }
    async fn handle(self: TeardownServiceHandler, q: TeardownService): Response {
        let existed = await self.cp.teardown(q.name);
        let msg = if (existed) "Tore down " + q.name + "." else "No such service: " + q.name + ".";
        let t = tree.treeView(await self.cp.nodes(), await self.cp.services(), "", "");
        return await sse.three(t, detail.welcome(), detail.toast(msg, existed));
    }
}
