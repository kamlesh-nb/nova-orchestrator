// The main-panel fragments (top-level id #detail) plus the #toast status line. Plain NSX throughout;
// actions are Datastar `data-on:click` (and the manifest form's `data-on:submit`). Expressions embed
// inline with `{...}` and the manifest form composes directly as a child.
import string;
import web.response;
import Domain.entities.cluster;
import Features.ControlPlane.views.form;

pub fn toastEmpty(): string { return <div id="toast"></div>; }

pub fn toast(msg: string, ok: bool): string {
    let cls = if (ok) "bg-emerald-50 text-emerald-800 ring-emerald-200" else "bg-rose-50 text-rose-800 ring-rose-200";
    return <div id="toast" class="mb-4">
        <div class={"rounded-lg px-4 py-2.5 text-sm font-medium ring-1 " + cls}>{response.escapeHtml(msg)}</div>
    </div>;
}

pub fn welcome(): string {
    return <div id="detail">
        <div class="flex h-full min-h-[60vh] items-center justify-center">
            <div class="max-w-md text-center">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100 text-2xl">{"&#9670;"}</div>
                <h2 class="text-lg font-semibold text-slate-800">Select something from the tree</h2>
                <p class="mt-1 text-sm text-slate-500">Click a node to deploy a service, or a service to view and edit its manifest.</p>
            </div>
        </div>
    </div>;
}

pub fn servicePanel(sv: cluster.ServiceView): string {
    return <div id="detail">
        <div class="mb-4 flex items-center gap-3">
            <h1 class="text-xl font-bold tracking-tight text-slate-900">{response.escapeHtml(sv.name)}</h1>
            <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600">{response.escapeHtml(sv.isolation)}</span>
            <button data-on:click={"@post('/api/services/" + sv.name + "/teardown')"} class="ml-auto rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-sm font-medium text-rose-700 hover:bg-rose-100">Tear down</button>
        </div>
        {response.raw(form.manifestForm(sv, true, "Save changes"))}
    </div>;
}

fn infoRow(k: string, v: string): string {
    return <div class="flex items-center justify-between border-b border-slate-100 py-2 last:border-0">
        <span class="text-sm text-slate-500">{k}</span>
        <span class="text-sm font-medium text-slate-800">{v}</span>
    </div>;
}

pub fn nodePanel(node: cluster.NodeView, serviceCount: int): string {
    return <div id="detail">
        <div class="mb-4 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600">{"&#9670;"}</div>
            <div>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">{response.escapeHtml(node.id)}</h1>
                <div class="text-xs text-slate-500">Cluster node</div>
            </div>
            <button data-on:click={"@get('/api/nodes/" + node.id + "/new')"} class="ml-auto rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">Deploy new service</button>
        </div>
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">Node information</h3>
            {response.raw(infoRow("Node ID", response.escapeHtml(node.id)))}
            {response.raw(infoRow("Advertise address", response.escapeHtml(node.address)))}
            {response.raw(infoRow("Role", "control plane (orchd)"))}
            {response.raw(infoRow("Services on the cluster", `${serviceCount}`))}
        </section>
    </div>;
}

pub fn deployPanel(node: cluster.NodeView): string {
    return <div id="detail">
        <div class="mb-4">
            <button data-on:click={"@get('/api/nodes/" + node.id + "')"} class="text-xs text-slate-500 hover:text-slate-700">{`← ${response.escapeHtml(node.id)}`}</button>
            <h1 class="mt-1 text-xl font-bold tracking-tight text-slate-900">Deploy a service</h1>
            <p class="mt-1 text-sm text-slate-500">A new workload for the cluster. It is written to the config store and reconciled onto the fleet.</p>
        </div>
        {form.manifestForm(cluster.ServiceView(), false, "Deploy service")}
    </div>;
}
