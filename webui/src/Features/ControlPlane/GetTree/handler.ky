// Renders the sidebar tree from the live store and patches #tree.
import web.response;
import web.routing;
import Features.ControlPlane.Shared.repo;
import Features.ControlPlane.Shared.sse;
import Features.ControlPlane.views.tree;

pub struct GetTreeHandler impl RouteHandler {
    cp: repo.ControlPlane,
    init(cp: repo.ControlPlane) { self.cp = cp; }
    async fn serve(self: GetTreeHandler, ctx: routing.Context): Response {
        return await sse.one(tree.treeView(await self.cp.nodes(), await self.cp.services(), "", ""));
    }
}
