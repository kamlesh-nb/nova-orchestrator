// Renders the sidebar tree from the live store and patches #tree.
import web.response;
import Features.ControlPlane.GetTree.query;
import Features.ControlPlane.Shared.store;
import Features.ControlPlane.Shared.sse;
import Features.ControlPlane.views.tree;

pub struct GetTreeHandler impl RequestHandler<GetTree, Response> {
    cp: store.ControlPlane,
    init(cp: store.ControlPlane) { self.cp = cp; }
    async fn handle(self: GetTreeHandler, q: GetTree): Response {
        return await sse.one(tree.treeView(await self.cp.nodes(), await self.cp.services(), "", ""));
    }
}
