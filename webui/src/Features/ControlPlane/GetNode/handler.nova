// Loads a node's information panel into #detail.
import web.response;
import Features.ControlPlane.GetNode.query;
import Features.ControlPlane.Shared.store;
import Features.ControlPlane.Shared.sse;
import Features.ControlPlane.views.detail;

pub struct GetNodeHandler impl RequestHandler<GetNode, Response> {
    cp: store.ControlPlane,
    init(cp: store.ControlPlane) { self.cp = cp; }
    async fn handle(self: GetNodeHandler, q: GetNode): Response {
        let node = await self.cp.node(q.id);
        let count = await self.cp.serviceCount();
        return await sse.one(detail.nodePanel(node, count));
    }
}
